---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  category = 'Personal',
  tags = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class="article-container">
      <article>
        <header class="article-header">
          <a href="/blog/" class="back-link">← All writing</a>

          <div class="article-meta">
            <span>{category}</span>
            <span>·</span>
            <FormattedDate date={pubDate} />
          </div>

          <h1>{title}</h1>

          <p class="article-description">{description}</p>

          {updatedDate && (
            <p class="updated">
              Updated <FormattedDate date={updatedDate} />
            </p>
          )}

          {tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )}
        </header>

        <div class="prose">
          <slot />
        </div>

        <footer class="article-footer">
          <p>End of article.</p>
          <a href="/blog/">← Back to all writing</a>
        </footer>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .article-container {
    width: min(100% - 3rem, 760px);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .article-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border, #deded8);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--muted, #777);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--muted, #777);
    font-size: 0.85rem;
  }

  .article-header h1 {
    margin: 1rem 0;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
  }

  .article-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--muted, #777);
  }

  .updated {
    font-size: 0.8rem;
    color: var(--muted, #777);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .tag {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border, #deded8);
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .prose {
    padding: 2.5rem 0;
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.7rem;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.3rem;
  }

  .prose :global(p) {
    margin: 1.3rem 0;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--accent);
    color: var(--muted, #777);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 8px;
  }

  .article-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border, #deded8);
    color: var(--muted, #777);
    font-size: 0.9rem;
  }

  .article-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .article-container {
      width: calc(100% - 2rem);
      padding-top: 2.5rem;
    }
  }
</style>
