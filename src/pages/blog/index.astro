---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Writing | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="archive">
      <header class="archive-header">
        <p class="eyebrow">THE JOURNAL</p>
        <h1>Writing</h1>
        <p class="intro">
          Thoughts, ideas, experiments, and things worth exploring.
        </p>
        <p class="post-count">
          {posts.length} {posts.length === 1 ? 'ARTICLE' : 'ARTICLES'}
        </p>
      </header>

      <section class="post-list">
        {posts.length > 0 ? (
          posts.map((post) => (
            <article class="post-item">
              <div class="post-meta">
                <FormattedDate date={post.data.pubDate} />
                <span class="separator">·</span>
                <span>{post.data.category}</span>
              </div>

              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>

              <p class="post-description">{post.data.description}</p>

              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}

              <a class="read-link" href={`/blog/${post.id}/`}>
                Read article <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        ) : (
          <p class="empty-state">No articles published yet.</p>
        )}
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .archive {
    width: min(100% - 3rem, 760px);
    margin: 0 auto;
    padding: 5rem 0 7rem;
  }

  .archive-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border, #deded8);
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    font-weight: 700;
    color: var(--accent);
  }

  .archive-header h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.055em;
    margin: 0.5rem 0;
  }

  .intro {
    color: var(--muted, #777);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .post-count {
    margin-top: 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--muted, #777);
  }

  .post-item {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border, #deded8);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--muted, #777);
  }

  .post-item h2 {
    margin: 0.8rem 0;
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.035em;
  }

  .post-item h2 a {
    color: inherit;
    text-decoration: none;
  }

  .post-item h2 a:hover {
    color: var(--accent);
  }

  .post-description {
    max-width: 650px;
    color: var(--muted, #777);
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  .tag {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border, #deded8);
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .read-link {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }

  .empty-state {
    padding: 3rem 0;
    color: var(--muted, #777);
  }

  @media (max-width: 600px) {
    .archive {
      width: calc(100% - 2rem);
      padding-top: 3rem;
    }
  }

  /* Archive-specific overrides */
  .archive .post-list {
    border-top: 1px solid var(--border);
  }

  .archive .post-item {
    display: block;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .archive .archive-header h1 {
    color: var(--text);
    margin: 0.5rem 0 1rem;
  }

  .archive .archive-header .intro {
    margin-bottom: 0;
  }

  .archive .post-meta {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .archive .post-item h2 {
    margin: 0 0 0.8rem;
    color: var(--text);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.3;
  }

  .archive .post-description {
    max-width: 650px;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .archive .tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }

  .archive .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--muted);
    background: var(--surface);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .archive .read-link {
    margin-top: 1.2rem;
  }

</style>
