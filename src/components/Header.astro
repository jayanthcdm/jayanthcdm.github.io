---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Just Scribbles home">
        just scribbles<span class="brand-dot">.</span>
        </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/blog/" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>Writing</a>
      <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>About</a>
    </nav>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Toggle colour theme"
      title="Toggle colour theme"
    >
      ◐
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const root = document.documentElement;

  const savedTheme = localStorage.getItem('theme');
  const preferredDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

  function applyTheme(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    if (toggle) {
      toggle.textContent = theme === 'dark' ? '☀' : '◐';
      toggle.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    }
  }

  applyTheme(savedTheme === 'dark' || savedTheme === 'light'
    ? savedTheme
    : preferredDark ? 'dark' : 'light');

  toggle?.addEventListener('click', () => {
    applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
  });
</script>
